# Copy to .env.production on the Oracle VM and fill real values.

SITE_DOMAIN=dst.imim.im
SITE_NAME=Distort
SITE_DESCRIPTION=A small link aggregation and discussion community.

OPEN_SIGNUPS=false
ALLOW_INVITATION_REQUESTS=false
ALLOW_NEW_USERS_TO_INVITE=true

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=change-me

# Generate strong, different passwords.
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_PASSWORD=change-me-app

# Brevo SMTP example. Keep these empty until the SMTP account is ready.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS_AUTO=true

# Backup policy for script/backup_mariadb.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
