#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 backups/lobsters-YYYYMMDDTHHMMSSZ.sql.gz" >&2
  exit 64
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -f .env.production ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.production
  set +a
fi

COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.production.yml}"
BACKUP_FILE="$1"

: "${MARIADB_ROOT_PASSWORD:?MARIADB_ROOT_PASSWORD is required}"

if [[ ! -f "$BACKUP_FILE" ]]; then
  echo "Backup file not found: $BACKUP_FILE" >&2
  exit 66
fi

if [[ "${FORCE:-}" != "1" ]]; then
  echo "This will overwrite the current lobsters database."
  echo "Re-run with FORCE=1 to continue."
  exit 1
fi

gunzip -c "$BACKUP_FILE" | docker compose -f "$COMPOSE_FILE" exec -T db \
  mariadb -uroot -p"${MARIADB_ROOT_PASSWORD}" lobsters
