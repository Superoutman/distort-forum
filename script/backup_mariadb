#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -f .env.production ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.production
  set +a
fi

COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.production.yml}"
BACKUP_DIR="${BACKUP_DIR:-backups}"
RETENTION_DAYS="${BACKUP_RETENTION_DAYS:-7}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="${BACKUP_DIR}/lobsters-${STAMP}.sql.gz"

: "${MARIADB_ROOT_PASSWORD:?MARIADB_ROOT_PASSWORD is required}"

mkdir -p "$BACKUP_DIR"

docker compose -f "$COMPOSE_FILE" exec -T db \
  mariadb-dump -uroot -p"${MARIADB_ROOT_PASSWORD}" \
  --single-transaction --routines --triggers lobsters \
  | gzip -9 > "$OUT"

find "$BACKUP_DIR" -type f -name 'lobsters-*.sql.gz' -mtime +"$RETENTION_DAYS" -delete

echo "$OUT"
